# Server-side Turso database credentials (required on Vercel Project 1 & Project 2)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional client-side cross-domain URLs when deploying Public & Admin on separate Vercel domains
# Public project: URL of your deployed Admin domain (defaults to /admin/ locally)
VITE_ADMIN_URL=

# Admin project: set VITE_BASE_PATH=/ on Vercel Admin project & URL of your Public domain
VITE_BASE_PATH=
VITE_PUBLIC_SITE_URL=
